    "            nn.ReLU(),\n",
    "            #32x112x112\n",
    "            nn.Conv2d(32, 64, 3, stride=2, padding=1),\n",
    "            nn.ReLU(),\n",
    "            #64x56x56\n",
    "            nn.Conv2d(64, 128, 3, stride=2, padding=1),\n",
